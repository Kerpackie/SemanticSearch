 "cells": [
  {
   "metadata": {},
   "cell_type": "raw",
   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# FFNN Recommendation API - Usage Demo\\n\",\n",
    "    \"\\n\",\n",
    "    \"This notebook demonstrates how to use the recommendation API.\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Prerequisites:**\\n\",\n",
    "    \"1. Start the API server in a terminal: `python api.py`\\n\",\n",
    "    \"2. Run this notebook\\n\",\n",
    "    \"\\n\",\n",
    "    \"The API provides two main endpoints:\\n\",\n",
    "    \"- `/score`: Score all provided articles for a customer\\n\",\n",
    "    \"- `/recommend`: Get top-K recommendations from a list of articles\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import requests\\n\",\n",
    "    \"import json\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"\\n\",\n",
    "    \"# API Configuration\\n\",\n",
    "    \"BASE_URL = \\\"http://localhost:8000\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"API Base URL:\\\", BASE_URL)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 1. Health Check\\n\",\n",
    "    \"\\n\",\n",
    "    \"First, let's verify the API is running and the model is loaded.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"response = requests.get(f\\\"{BASE_URL}/\\\")\\n\",\n",
    "    \"health = response.json()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Status:\\\", health['status'])\\n\",\n",
    "    \"print(\\\"Model Loaded:\\\", health['model_loaded'])\\n\",\n",
    "    \"print(\\\"\\\\nModel Metadata:\\\")\\n\",\n",
    "    \"print(json.dumps(health['metadata'], indent=2))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 2. Load Sample Data\\n\",\n",
    "    \"\\n\",\n",
    "    \"Let's load some real customer and article IDs from our dataset.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Load a sample of transactions to get real customer and article IDs\\n\",\n",
    "    \"transactions = pd.read_csv(\\\"transactions_train.csv\\\", nrows=10000)\\n\",\n",
    "    \"articles = pd.read_csv(\\\"articles.csv\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Get a random customer who has made purchases\\n\",\n",
    "    \"sample_customer = transactions['customer_id'].value_counts().head(10).index[0]\\n\",\n",
    "    \"print(f\\\"Sample Customer ID: {sample_customer}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Get some random articles\\n\",\n",
    "    \"sample_articles = articles['article_id'].sample(20).tolist()\\n\",\n",
    "    \"print(f\\\"\\\\nSample Articles (first 5): {sample_articles[:5]}\\\")\\n\",\n",
    "    \"print(f\\\"Total articles to score: {len(sample_articles)}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 3. Score Articles\\n\",\n",
    "    \"\\n\",\n",
    "    \"Score all articles for the customer and see their predicted purchase probabilities.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Make the request\\n\",\n",
    "    \"response = requests.post(\\n\",\n",
    "    \"    f\\\"{BASE_URL}/score\\\",\\n\",\n",
    "    \"    json={\\n\",\n",
    "    \"        \\\"customer_id\\\": sample_customer,\\n\",\n",
    "    \"        \\\"article_ids\\\": sample_articles\\n\",\n",
    "    \"    }\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Parse results\\n\",\n",
    "    \"result = response.json()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Convert to DataFrame for easier viewing\\n\",\n",
    "    \"scores_df = pd.DataFrame(result['scores'])\\n\",\n",
    "    \"scores_df = scores_df.sort_values('score', ascending=False).reset_index(drop=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Customer: {result['customer_id']}\\\")\\n\",\n",
    "    \"print(f\\\"\\\\nTop 10 Scored Articles:\\\")\\n\",\n",
    "    \"print(scores_df.head(10))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Summary statistics\\n\",\n",
    "    \"print(f\\\"\\\\nScore Statistics:\\\")\\n\",\n",
    "    \"print(scores_df['score'].describe())\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 4. Visualize Scores\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Plot score distribution\\n\",\n",
    "    \"plt.figure(figsize=(12, 5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.subplot(1, 2, 1)\\n\",\n",
    "    \"plt.hist(scores_df['score'], bins=20, edgecolor='black')\\n\",\n",
    "    \"plt.xlabel('Score')\\n\",\n",
    "    \"plt.ylabel('Frequency')\\n\",\n",
    "    \"plt.title('Distribution of Article Scores')\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.subplot(1, 2, 2)\\n\",\n",
    "    \"plt.bar(range(len(scores_df)), scores_df['score'])\\n\",\n",
    "    \"plt.xlabel('Article Rank')\\n\",\n",
    "    \"plt.ylabel('Score')\\n\",\n",
    "    \"plt.title('Scores Ranked from Highest to Lowest')\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 5. Get Top-K Recommendations\\n\",\n",
    "    \"\\n\",\n",
    "    \"Use the `/recommend` endpoint to get only the top recommendations.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Get top 5 recommendations\\n\",\n",
    "    \"response = requests.post(\\n\",\n",
    "    \"    f\\\"{BASE_URL}/recommend?top_k=5\\\",\\n\",\n",
    "    \"    json={\\n\",\n",
    "    \"        \\\"customer_id\\\": sample_customer,\\n\",\n",
    "    \"        \\\"article_ids\\\": sample_articles\\n\",\n",
    "    \"    }\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"result = response.json()\\n\",\n",
    "    \"recommendations_df = pd.DataFrame(result['scores'])\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Top 5 Recommendations for Customer {result['customer_id']}:\\\")\\n\",\n",
    "    \"print(recommendations_df)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Merge with article details\\n\",\n",
    "    \"recommendations_with_details = recommendations_df.merge(\\n\",\n",
    "    \"    articles[['article_id', 'prod_name', 'product_type_name', 'colour_group_name']],\\n\",\n",
    "    \"    on='article_id',\\n\",\n",
    "    \"    how='left'\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"\\\\nWith Product Details:\\\")\\n\",\n",
    "    \"print(recommendations_with_details)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 6. Compare Multiple Customers\\n\",\n",
    "    \"\\n\",\n",
    "    \"Let's see how different customers get different recommendations for the same set of articles.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Get 3 different customers\\n\",\n",
    "    \"customers = transactions['customer_id'].value_counts().head(3).index.tolist()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Use a fixed set of articles\\n\",\n",
    "    \"test_articles = articles['article_id'].sample(10).tolist()\\n\",\n",
    "    \"\\n\",\n",
    "    \"results = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"for customer in customers:\\n\",\n",
    "    \"    response = requests.post(\\n\",\n",
    "    \"        f\\\"{BASE_URL}/recommend?top_k=3\\\",\\n\",\n",
    "    \"        json={\\n\",\n",
    "    \"            \\\"customer_id\\\": customer,\\n\",\n",
    "    \"            \\\"article_ids\\\": test_articles\\n\",\n",
    "    \"        }\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    result = response.json()\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    for item in result['scores']:\\n\",\n",
    "    \"        results.append({\\n\",\n",
    "    \"            'customer_id': customer[:16] + '...',  # Truncate for display\\n\",\n",
    "    \"            'article_id': item['article_id'],\\n\",\n",
    "    \"            'score': item['score']\\n\",\n",
    "    \"        })\\n\",\n",
    "    \"\\n\",\n",
    "    \"comparison_df = pd.DataFrame(results)\\n\",\n",
    "    \"pivot_df = comparison_df.pivot(index='article_id', columns='customer_id', values='score')\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Top 3 Recommendations for Different Customers:\\\")\\n\",\n",
    "    \"print(pivot_df)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Visualize\\n\",\n",
    "    \"pivot_df.plot(kind='bar', figsize=(12, 6))\\n\",\n",
    "    \"plt.xlabel('Article ID')\\n\",\n",
    "    \"plt.ylabel('Score')\\n\",\n",
    "    \"plt.title('Recommendation Scores by Customer')\\n\",\n",
    "    \"plt.legend(title='Customer ID')\\n\",\n",
    "    \"plt.xticks(rotation=45)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 7. Batch Processing Example\\n\",\n",
    "    \"\\n\",\n",
    "    \"Process recommendations for multiple customers efficiently.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import time\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Get 10 customers\\n\",\n",
    "    \"test_customers = transactions['customer_id'].unique()[:10]\\n\",\n",
    "    \"candidate_articles = articles['article_id'].sample(50).tolist()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Processing {len(test_customers)} customers with {len(candidate_articles)} candidate articles...\\\\n\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"start_time = time.time()\\n\",\n",
    "    \"all_recommendations = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"for i, customer in enumerate(test_customers, 1):\\n\",\n",
    "    \"    response = requests.post(\\n\",\n",
    "    \"        f\\\"{BASE_URL}/recommend?top_k=12\\\",\\n\",\n",
    "    \"        json={\\n\",\n",
    "    \"            \\\"customer_id\\\": customer,\\n\",\n",
    "    \"            \\\"article_ids\\\": candidate_articles\\n\",\n",
    "    \"        }\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    if response.status_code == 200:\\n\",\n",
    "    \"        result = response.json()\\n\",\n",
    "    \"        all_recommendations.append({\\n\",\n",
    "    \"            'customer_id': customer,\\n\",\n",
    "    \"            'top_article': result['scores'][0]['article_id'],\\n\",\n",
    "    \"            'top_score': result['scores'][0]['score'],\\n\",\n",
    "    \"            'num_recommendations': len(result['scores'])\\n\",\n",
    "    \"        })\\n\",\n",
    "    \"        print(f\\\"✓ {i}/{len(test_customers)} - Customer {customer[:16]}... (top score: {result['scores'][0]['score']:.4f})\\\")\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        print(f\\\"✗ {i}/{len(test_customers)} - Failed for customer {customer[:16]}...\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"elapsed_time = time.time() - start_time\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"\\\\n✅ Processed {len(all_recommendations)} customers in {elapsed_time:.2f} seconds\\\")\\n\",\n",
    "    \"print(f\\\"Average time per customer: {elapsed_time/len(test_customers):.3f} seconds\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Show results\\n\",\n",
    "    \"results_df = pd.DataFrame(all_recommendations)\\n\",\n",
    "    \"print(\\\"\\\\nBatch Results:\\\")\\n\",\n",
    "    \"print(results_df)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 8. Error Handling\\n\",\n",
    "    \"\\n\",\n",
    "    \"Test how the API handles invalid inputs.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Test with empty article list\\n\",\n",
    "    \"print(\\\"Test 1: Empty article list\\\")\\n\",\n",
    "    \"response = requests.post(\\n\",\n",
    "    \"    f\\\"{BASE_URL}/score\\\",\\n\",\n",
    "    \"    json={\\n\",\n",
    "    \"        \\\"customer_id\\\": sample_customer,\\n\",\n",
    "    \"        \\\"article_ids\\\": []\\n\",\n",
    "    \"    }\\n\",\n",
    "    \")\\n\",\n",
    "    \"print(f\\\"Status Code: {response.status_code}\\\")\\n\",\n",
    "    \"print(f\\\"Response: {response.json()}\\\\n\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Test with non-existent customer (should still work, using default features)\\n\",\n",
    "    \"print(\\\"Test 2: Non-existent customer\\\")\\n\",\n",
    "    \"response = requests.post(\\n\",\n",
    "    \"    f\\\"{BASE_URL}/score\\\",\\n\",\n",
    "    \"    json={\\n\",\n",
    "    \"        \\\"customer_id\\\": \\\"fake_customer_id_12345\\\",\\n\",\n",
    "    \"        \\\"article_ids\\\": sample_articles[:5]\\n\",\n",
    "    \"    }\\n\",\n",
    "    \")\\n\",\n",
    "    \"print(f\\\"Status Code: {response.status_code}\\\")\\n\",\n",
    "    \"if response.status_code == 200:\\n\",\n",
    "    \"    result = response.json()\\n\",\n",
    "    \"    print(f\\\"Received {len(result['scores'])} scores (using default features)\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print(f\\\"Response: {response.json()}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Summary\\n\",\n",
    "    \"\\n\",\n",
    "    \"This notebook demonstrated:\\n\",\n",
    "    \"\\n\",\n",
    "    \"1. ✅ Health check to verify API status\\n\",\n",
    "    \"2. ✅ Scoring articles for a customer\\n\",\n",
    "    \"3. ✅ Getting top-K recommendations\\n\",\n",
    "    \"4. ✅ Visualizing recommendation scores\\n\",\n",
    "    \"5. ✅ Comparing recommendations across customers\\n\",\n",
    "    \"6. ✅ Batch processing multiple customers\\n\",\n",
    "    \"7. ✅ Error handling\\n\",\n",
    "    \"\\n\",\n",
    "    \"The API is ready to be integrated into your application!\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
