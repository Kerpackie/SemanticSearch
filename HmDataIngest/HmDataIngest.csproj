<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>dotnet-HmDataIngest-af092e8c-a581-4547-8f02-cd841da03dce</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <!-- CSV Parsing -->
        <PackageReference Include="CsvHelper" Version="30.0.1" />

        <!-- gRPC Support -->
        <PackageReference Include="Google.Protobuf" Version="3.25.1" />
        <PackageReference Include="Grpc.Net.Client" Version="2.60.0" />
        <PackageReference Include="Grpc.Tools" Version="2.60.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>


    <ItemGroup>
        <!-- 
          FIXED:
          1. Removed the nested <GrpcServices>Server</GrpcServices> tags which were overriding your setting.
          2. Removed the hardcoded <OutputDir>, letting MSBuild handle it avoids conflicts.
        -->
        <Protobuf Include="Protos\embedding.proto" GrpcServices="Client" />
        <Protobuf Include="Protos\product.proto" GrpcServices="Client" />
        <Protobuf Include="Protos\clip.proto" GrpcServices="Client" />

        <!-- Optional: Keep if you are using it, otherwise remove -->
        <Protobuf Include="Protos\greet.proto" GrpcServices="Client" />
    </ItemGroup>

</Project>
